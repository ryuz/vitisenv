#!/usr/bin/env bash

if [ -z "${XILINX_INSTALL_DIR}" ]; then
  XILINX_INSTALL_DIR="/tools/Xilinx"
fi

CMD_NAME=`basename $0`
if [ "$CMD_NAME" = vitisenv-exec ]; then
#  echo "vitisenv-exec cannot be called directly"
#  exit 1
  CMD_NAME=$1
  shift 1
fi

VITIS_VERSION=`vitisenv-version`
if [ -z "${VITIS_VERSION}" ]; then
  echo "Error: vitisenv version not found."
else
  SETTING_FILE=$XILINX_INSTALL_DIR/Vitis/$VITIS_VERSION/settings64.sh
  if [ -e "$SETTING_FILE" ]; then
    source "$SETTING_FILE"
    $CMD_NAME $@
  else
    # Fallback: try Vivado location
    ALT_SETTING_FILE=$XILINX_INSTALL_DIR/Vivado/$VITIS_VERSION/settings64.sh
    if [ -e "$ALT_SETTING_FILE" ]; then
      source "$ALT_SETTING_FILE"
      $CMD_NAME $@
    else
      echo "$SETTING_FILE is not found."
      echo "$ALT_SETTING_FILE is not found."
    fi
  fi
fi
